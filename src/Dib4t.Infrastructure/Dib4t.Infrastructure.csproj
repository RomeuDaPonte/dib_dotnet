<Project Sdk="Microsoft.NET.Sdk">
  <!-- PLAN.md §3: MongoDB, NAS (SSH.NET), label printer, PDF, backup format, logging store. -->

  <ItemGroup>
    <!-- Options binding/validation and hosting abstractions for the adapters (no HTTP code lives here). -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="BCrypt.Net-Next" />
    <PackageReference Include="MongoDB.Driver" />
    <!-- Log store (PLAN.md §3.3): SQLite file with FTS5, written by a Serilog sink. -->
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="System.IO.Hashing" />
    <!-- Budget PDF (PLAN.md §7.1): the document writer; layout, shaping and fonts are the legacy pdfmake's, ported. -->
    <PackageReference Include="PDFsharp" />
  </ItemGroup>

  <ItemGroup>
    <!-- Legacy inputs of the budget PDF, written by tools/legacy/pdf-golden.js (see Pdf/Assets/README.md). -->
    <EmbeddedResource Include="Pdf/Assets/*.ttf;Pdf/Assets/*.jpg;Pdf/Assets/*.txt" LogicalName="Dib4t.Infrastructure.Pdf.Assets.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Dib4t.Infrastructure.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Dib4t.Application\Dib4t.Application.csproj" />
  </ItemGroup>
</Project>
