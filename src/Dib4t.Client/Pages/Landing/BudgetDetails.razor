@page "/landing/budgets/{BudgetId}"
@layout LandingLayout
@implements IDisposable
@inject AuthSession Session
@inject BudgetDetailsState State

<PageTitle>Dib4t</PageTitle>

@* Legacy budgetDetails/indexBudgetDetails.jsx + budgetDetails.jsx: the header (BudgetDetailsHeader), then the tasks
   or (Alternar) the description with "Concluir"; the edit and import dialogs. The behavior lives in
   BudgetDetailsState. *@
@if (Session.User?.HasRole(RoleNames.CanSeeOrcamentos) != true)
{
    <p class="settings-denied">@AuthTexts.NoPermission</p>
}
else if (State.Budget is { } budget)
{
    <div class="budget-details">
        <BudgetDetailsHeader State="State" Zone="Zone" OnEdit="() => _form = BudgetForm.Edit(budget)" OnImport="() => _importing = true" />
        @if (State.IsLoaded)
        {
            @if (State.ShowTasks)
            {
                <div class="budget-tasks">
                    @for (var i = 0; i < State.Tasks.Count; i++)
                    {
                        var index = i;
                        var row = State.Tasks[i];
                        <BudgetTaskEditor @key="row.Id" State="State" Row="row" Index="index" ShowDelete="@(State.Tasks.Count > 1)" />
                    }
                    @if (State.Tasks.Count == 0)
                    {
                        @* Fixed legacy UI defect: a budget without tasks renders nothing in legacy, so it could never get one back. *@
                        <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="() => State.AddTaskAsync(null)">
                            Adicionar
                        </MudButton>
                    }
                </div>
            }
            else
            {
                <BudgetDescriptionEditor State="State" />
            }
        }
    </div>
    <BudgetDialog Form="_form" OnSaved="Saved" OnClosed="() => _form = null" />
    <ImportBudgetDialog State="State" Visible="_importing" OnClosed="() => _importing = false" />
}
else if (State.LoadError is { } error)
{
    <p class="settings-denied">@error</p>
}

@code {
    private BudgetForm? _form;
    private bool _importing;

    [Parameter]
    public string BudgetId { get; set; } = string.Empty;

    /// <summary>The browser's zone (legacy <c>toLocaleDateString</c>); tests set it.</summary>
    [Parameter]
    public TimeZoneInfo Zone { get; set; } = TimeZoneInfo.Local;

    protected override void OnInitialized() => State.Changed += Refresh;

    protected override async Task OnParametersSetAsync()
    {
        if (Session.User?.HasRole(RoleNames.CanSeeOrcamentos) == true)
        {
            await State.LoadAsync(BudgetId);
        }
    }

    public void Dispose() => State.Changed -= Refresh;

    private void Refresh() => _ = InvokeAsync(StateHasChanged);

    private void Saved(BudgetResponse saved)
    {
        State.Replace(saved);
        _form = null;
    }
}
