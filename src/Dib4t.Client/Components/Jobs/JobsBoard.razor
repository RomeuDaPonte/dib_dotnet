@inject IJobApi JobApi
@inject IClipboard Clipboard
@inject AuthSession Session
@inject ISnackbar Snackbar
@inject TimeProvider Time

@* Legacy components/job/*: the tabs with their counters (the first tab from the user's field of competence), the
   table (server order until a column is sorted; pager 5/10/25, 25; dense switch, on), per row the due-date picker
   with its countdown and the priority icon, the state (red when deleted), "Ft %" in "Para faturação", and the
   actions: copy path, comments, state menu, priority menu, order/delivered/non-conformity icons. The table scrolls
   inside its own container (§8.4 rule 5). *@
<MudPaper Elevation="1" Class="jobs">
    <SettingsTabs Tabs="TabItems" Counts="Counts" Label="Obras" Active="_tab" ActiveChanged="TabChangedAsync" Context="tabIndex">
        <MudTable @ref="_table" T="JobRow" Items="_rows" Dense="_dense" Hover="true" HorizontalScrollbar="true" Elevation="0" RowsPerPage="_rowsPerPage"
                  @bind-CurrentPage="_page" Breakpoint="Breakpoint.None" Class="settings-table jobs-table" aria-label="Obras" Loading="_loading">
            <HeaderContent>
                <MudTh><MudTableSortLabel T="JobRow" SortBy="j => EntityList.SortKey(j.BudgetNumber)">Nº</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel T="JobRow" SortBy="j => EntityList.SortKey(j.Client)">Cliente</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel T="JobRow" SortBy="j => EntityList.SortKey(j.Descriptive)">Descritivo</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel T="JobRow" SortBy="j => j.StartDate ?? DateTime.MinValue">Data de inicio</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel T="JobRow" SortBy="j => j.DueDate ?? DateTime.MinValue">Finalizar até</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel T="JobRow" SortBy="j => j.State">Estado</MudTableSortLabel></MudTh>
                @if (ShowsInvoiced)
                {
                    <MudTh><MudTableSortLabel T="JobRow" SortBy="j => j.InvoicedPercent ?? 0">Ft %</MudTableSortLabel></MudTh>
                }
                <MudTh><span class="visually-hidden">Opções</span></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Nº" Class="jobs-number">@context.BudgetNumber</MudTd>
                <MudTd DataLabel="Cliente" Class="settings-wrap">@context.Client</MudTd>
                <MudTd DataLabel="Descritivo" Class="settings-wrap">@context.Descriptive</MudTd>
                <MudTd DataLabel="Data de inicio">@JobBoard.Date(context.StartDate, Zone)</MudTd>
                <MudTd DataLabel="Finalizar até" Class="jobs-due">
                    @{ var countdown = context.DueDate is { } due ? JobBoard.Countdown(JobBoard.DaysLeft(due, Time.GetUtcNow(), Zone)) : (JobIcons.Late, "job-countdown-red"); }
                    <MudIcon Icon="@countdown.Item1" Class="@(JobBoard.HidesCountdown(context.State) ? "job-countdown-hidden" : countdown.Item2)"
                             aria-hidden="true" />
                    <input type="date" class="jobs-due-input" value="@JobBoard.DateInput(context.DueDate)" aria-label="@($"Finalizar até de {context.BudgetNumber}")"
                           @onchange="e => DueDateChangedAsync(context, e.Value as string)" />
                    <span class="jobs-priority">
                        @if (JobBoard.ShowsPriority(context.State) && context.Priority == JobPriorities.High)
                        {
                            <MudTooltip Text="Prioritário"><MudIcon Icon="@JobIcons.PriorityHigh" Class="jobs-priority-high" aria-label="Prioritário" /></MudTooltip>
                        }
                        else if (JobBoard.ShowsPriority(context.State) && context.Priority == JobPriorities.Low)
                        {
                            <MudTooltip Text="Não Prioritário"><MudIcon Icon="@JobIcons.PriorityLow" Class="jobs-priority-low" aria-label="Não Prioritário" /></MudTooltip>
                        }
                    </span>
                </MudTd>
                <MudTd DataLabel="Estado" Class="@(context.State == JobStates.Deleted ? "jobs-deleted" : null)">@context.State</MudTd>
                @if (ShowsInvoiced)
                {
                    <MudTd DataLabel="Ft %" Class="jobs-invoiced">
                        @if (context.State == JobStates.ForInvoicing)
                        {
                            @($"{(context.InvoicedPercent is { } percent ? JsNumber.ToString(percent) : "undefined")} %")
                        }
                    </MudTd>
                }
                <MudTd DataLabel="Opções" Class="jobs-actions">
                    <span class="jobs-action">
                        <MudTooltip Text="Copiar caminho">
                            <MudIconButton Icon="@Icons.Material.Filled.CopyAll" Class="budgets-copy" aria-label="@($"Copiar caminho de {context.BudgetNumber}")"
                                           OnClick="() => CopyPathAsync(context)" />
                        </MudTooltip>
                    </span>
                    <span class="jobs-action">
                        @if (!string.IsNullOrEmpty(context.Comments))
                        {
                            <MudTooltip Text="Info">
                                <MudIconButton Icon="@Icons.Material.Filled.Info" Class="jobs-comments" aria-label="@($"Comentários de {context.BudgetNumber}")"
                                               OnClick="() => OpenCommentsAsync(context)" />
                            </MudTooltip>
                        }
                    </span>
                    <span class="jobs-action">
                        <MudTooltip Text="Alterar estado">
                            <MudMenu Icon="@Icons.Material.Filled.Autorenew" AriaLabel="@($"Alterar estado de {context.BudgetNumber}")" Dense="true">
                                @foreach (var (state, label, icon) in JobBoard.StateMenu(context.State))
                                {
                                    <MudMenuItem Icon="@icon" OnClick="@(() => ChooseStateAsync(context, state))">@label</MudMenuItem>
                                }
                            </MudMenu>
                        </MudTooltip>
                    </span>
                    <span class="jobs-action">
                        @if (JobBoard.ShowsPriority(context.State))
                        {
                            <MudTooltip Text="Opções">
                                <MudMenu Icon="@Icons.Material.Filled.MoreVert" AriaLabel="@($"Opções de {context.BudgetNumber}")" Dense="true">
                                    @foreach (var (label, priority, icon) in JobBoard.PriorityMenu)
                                    {
                                        <MudMenuItem Icon="@icon" OnClick="@(() => ChangePriorityAsync(context, priority))">@label</MudMenuItem>
                                    }
                                    <MudDivider />
                                    @* legacy: budgetId = the row's budget._id; a job without its budget sends "undefined" (the server's 400 text) *@
                                    <MudMenuItem Icon="@Icons.Material.Filled.LocalPrintshop" OnClick="@(() => _printBudgetId = context.BudgetId ?? "undefined")">Imprimir</MudMenuItem>
                                </MudMenu>
                            </MudTooltip>
                        }
                    </span>
                    <span class="jobs-action">
                        @if (context.ShowsOrderCheck)
                        {
                            <MudTooltip Text="Emcomenda"><MudIcon Icon="@Icons.Material.Filled.TaskAlt" Class="jobs-ok" aria-label="Emcomenda" /></MudTooltip>
                        }
                    </span>
                    <span class="jobs-action">
                        @if (context.ShowsDelivered)
                        {
                            <MudTooltip Text="Entregue"><MudIcon Icon="@Icons.Material.Filled.Output" Class="jobs-ok" aria-label="Entregue" /></MudTooltip>
                        }
                    </span>
                    <span class="jobs-action">
                        @if (context.HasNonConformity)
                        {
                            <MudTooltip Text="Não conformidade">
                                <MudIcon Icon="@Icons.Material.TwoTone.Warning" Class="jobs-warning" aria-label="Não conformidade" />
                            </MudTooltip>
                        }
                    </span>
                </MudTd>
            </RowTemplate>
            <PagerContent>
                <div class="settings-pager">
                    <LabeledSelect TValue="int" Id="jobs-rows-per-page" Label="Rows per page:" Value="_rowsPerPage" ValueChanged="RowsPerPageChanged"
                                   Options="RowsPerPageOptions" Class="settings-pager-size" />
                    <span class="settings-pager-info">@PageInfo</span>
                    <MudIconButton Icon="@Icons.Material.Filled.NavigateBefore" aria-label="Previous page" Disabled="_page == 0" OnClick="() => _page--" />
                    <MudIconButton Icon="@Icons.Material.Filled.NavigateNext" aria-label="Next page" Disabled="(_page + 1) * _rowsPerPage >= _rows.Count" OnClick="() => _page++" />
                </div>
            </PagerContent>
        </MudTable>
        <MudSwitch T="bool" @bind-Value="_dense" Label="Tabela densa" Color="Color.Primary" Class="settings-dense" />
    </SettingsTabs>
</MudPaper>

<JobStatisticsDialog Form="_statistics" OnSaved="StatisticsSavedAsync" OnRefused="StatisticsRefusedAsync" OnClosed="() => _statistics = null" />

<JobCommentsDialog Form="_comments" Number="@_commentsNumber" OnSaved="CommentsSavedAsync" OnClosed="() => _comments = null" />
<PrintLabelsDialog BudgetId="@_printBudgetId" OnClosed="() => _printBudgetId = null" />

@code {
    private static readonly IReadOnlyList<(int Value, string Text)> RowsPerPageOptions = [(5, "5"), (10, "10"), (25, "25")];

    private static readonly IReadOnlyList<(string Text, string Icon)> TabItems = [.. JobBoard.Tabs.Select(t => (t.Label, t.Icon))];

    private MudTable<JobRow>? _table;
    private List<JobRow> _rows = [];
    private JobCountsResponse? _counts;
    private JobStatisticsForm? _statistics;
    private JobCommentsForm? _comments;
    private string? _printBudgetId;
    private string? _commentsNumber;
    private int _tab;
    private bool _dense = true;
    private bool _loading = true;
    private int _page;
    private int _rowsPerPage = 25;
    private int _load;

    /// <summary>The browser's zone (legacy local dates); tests set it.</summary>
    [Parameter]
    public TimeZoneInfo Zone { get; set; } = TimeZoneInfo.Local;

    private bool ShowsAll => _tab == 0;

    private bool ShowsInvoiced => _tab == JobBoard.ForInvoicingTab;

    private IReadOnlyList<string?> Counts =>
        [.. JobBoard.Tabs.Select(t => t.Count is null ? "-" : _counts is null ? null : t.Count(_counts).ToString(System.Globalization.CultureInfo.InvariantCulture))];

    private string PageInfo => _rows.Count == 0 ? "0-0 of 0" : $"{(_page * _rowsPerPage) + 1}-{Math.Min((_page + 1) * _rowsPerPage, _rows.Count)} of {_rows.Count}";

    protected override async Task OnInitializedAsync()
    {
        _tab = JobBoard.InitialTab(Session.User?.FieldOfCompetencies);
        await Task.WhenAll(LoadRowsAsync(), LoadCountsAsync());
    }

    private async Task TabChangedAsync(int tab)
    {
        _tab = tab;
        _page = 0;
        await LoadRowsAsync();
    }

    /// <summary>Legacy <c>useJobs</c>: the open jobs, the jobs of one state, or billed and deleted together.</summary>
    private async Task LoadRowsAsync()
    {
        var load = ++_load;
        _loading = true;
        var tab = JobBoard.Tabs[_tab];
        List<JobRow>? rows;
        if (tab.States is null)
        {
            rows = Rows(await JobApi.ListUnfinishedAsync());
        }
        else if (tab.States.Count == 1)
        {
            rows = Rows(await JobApi.ListByStateAsync(tab.States[0]));
        }
        else
        {
            var billed = Rows(await JobApi.ListByStateAsync(tab.States[0]));
            var deleted = Rows(await JobApi.ListByStateAsync(tab.States[1]));
            rows = billed is null || deleted is null ? null : JobBoard.Merged(billed, deleted);
        }

        if (load == _load)
        {
            _rows = rows ?? [];
            _loading = false;
        }
    }

    private List<JobRow>? Rows(ApiResult<IReadOnlyList<JobResponse<JobListBudgetResponse>>> result)
    {
        if (result.IsSuccess)
        {
            return [.. result.Value!.Select(JobRow.From)];
        }

        Show(result);
        return null;
    }

    /// <summary>Legacy <c>useJobsCounter</c>: read again after every change of the list.</summary>
    private async Task LoadCountsAsync()
    {
        var counts = await JobApi.CountsAsync();
        if (counts.IsSuccess)
        {
            _counts = counts.Value;
        }
    }

    private async Task CopyPathAsync(JobRow row)
    {
        var copied = await Clipboard.CopyAsync(JobBoard.CopyPath(row.BudgetNumber, row.Client, row.Descriptive, row.State));
        Snackbar.Add(copied ? "Link copiado!" : "Erro ao copiar!", copied ? Severity.Success : Severity.Error);
    }

    /// <summary>
    /// Legacy <c>updateDate</c>: the new date, then the list in due-date and priority order. Sent when a date is picked
    /// (legacy sends on leaving the field, also unchanged or emptied, which the server answers with a 500).
    /// </summary>
    private async Task DueDateChangedAsync(JobRow row, string? date)
    {
        if (string.IsNullOrEmpty(date) || date == JobBoard.DateInput(row.DueDate))
        {
            return;
        }

        var saved = await JobApi.ChangeDueDateAsync(row.Id, date);
        if (!saved.IsSuccess)
        {
            Show(saved);
            return;
        }

        Snackbar.Add("Data atualizada com sucesso.", Severity.Success);
        _rows = JobBoard.Reordered(_rows, JobRow.From(saved.Value!));
        await LoadCountsAsync();
    }

    private async Task ChooseStateAsync(JobRow row, string state)
    {
        switch (JobBoard.Choose(row.State, state))
        {
            case StateChoice.ChangeNow:
                var saved = await JobApi.ChangeStateAsync(row.Id, state);
                if (!saved.IsSuccess)
                {
                    Show(saved);
                    return;
                }

                Moved(JobRow.From(saved.Value!), sameState: false);
                Snackbar.Add("Estado atualizado com sucesso", Severity.Success);
                await LoadCountsAsync();
                break;
            case StateChoice.OpenStatistics:
                var job = await JobApi.GetByIdAsync(row.Id);
                if (job.IsSuccess)
                {
                    _statistics = JobStatisticsForm.For(job.Value!, state);
                }
                else
                {
                    Show(job);
                }

                break;
        }
    }

    /// <summary>Legacy dialog <c>handleSubmit</c>: "Todas" or the same state updates the row; another tab drops a moved job.</summary>
    private async Task StatisticsSavedAsync(JobResponse<BudgetResponse> job)
    {
        var form = _statistics!;
        _statistics = null;
        Moved(JobRow.From(job), sameState: form.NewState == form.CurrentState);
        Snackbar.Add("Estado atualizado com sucesso!", Severity.Success);
        await LoadCountsAsync();
    }

    /// <summary>The legacy 405 ("Faturada" below 100 %): a warning, the saved job's row updated, the dialog closed.</summary>
    private async Task StatisticsRefusedAsync(JobStatisticsRefusedResponse refused)
    {
        _statistics = null;
        Snackbar.Add(refused.Reason, Severity.Warning);
        _rows = JobBoard.Replaced(_rows, JobRow.From(refused.UpdatedJob));
        await LoadCountsAsync();
    }

    private void Moved(JobRow saved, bool sameState) =>
        _rows = ShowsAll || sameState ? JobBoard.Replaced(_rows, saved) : JobBoard.WithoutMoved(_rows, saved);

    private async Task ChangePriorityAsync(JobRow row, string priority)
    {
        var saved = await JobApi.ChangePriorityAsync(row.Id, priority);
        if (!saved.IsSuccess)
        {
            Show(saved);
            return;
        }

        _rows = JobBoard.Reordered(_rows, JobRow.From(saved.Value!));
        await LoadCountsAsync();
    }

    private async Task OpenCommentsAsync(JobRow row)
    {
        var job = await JobApi.GetByIdAsync(row.Id);
        if (job.IsSuccess)
        {
            _comments = new JobCommentsForm(job.Value!);
            _commentsNumber = row.BudgetNumber;
        }
        else
        {
            Show(job);
        }
    }

    /// <summary>The comments were saved: the row shows them (legacy keeps the row as it was until the page is reloaded).</summary>
    private Task CommentsSavedAsync(JobResponse<BudgetResponse> job)
    {
        _comments = null;
        _rows = JobBoard.Replaced(_rows, JobRow.From(job));
        Snackbar.Add("Estado atualizado com sucesso!", Severity.Success);
        return LoadCountsAsync();
    }

    private void Show<T>(ApiResult<T> result)
    {
        if (!result.IsSuccess && !result.IsUnexpected)
        {
            Snackbar.Add(result.ErrorText!, Severity.Error);
        }
    }

    private void RowsPerPageChanged(int rows)
    {
        _rowsPerPage = rows;
        _page = 0;
        _table?.SetRowsPerPage(rows);
    }
}
