@* Legacy budgetDetails/importBudgetDetailsModal.jsx, with the D24 behavior (PLAN.md §9): this budget's tasks are
   ADDED to, and/or its description REPLACES the one of, the highest revision of the typed number (both ticked at
   first). Nothing is deleted. The legacy notice ("… irão discartar as atuais") no longer applies. *@
<MudDialog Visible="Visible" VisibleChanged="VisibleChanged" Options="Options" Class="settings-dialog" AriaLabel="Importar">
    <TitleContent><h2 class="settings-dialog-title">Importar</h2></TitleContent>
    <DialogContent>
        <MudAlert Severity="Severity.Info" Dense="true" Class="budget-import-alert">As tarefas deste orçamento são adicionadas e a descrição substitui a atual na última revisão do orçamento indicado. Nada é apagado.</MudAlert>
        <form id="import-form" novalidate @onsubmit="SubmitAsync">
            <MudCheckBox T="bool" @bind-Value="_tasks" Label="Tarefas" Color="Color.Primary" />
            <MudCheckBox T="bool" @bind-Value="_description" Label="Descrição" Color="Color.Primary" />
            <MudTextField T="string" @bind-Value="_number" Immediate="true" Label="Nª Orçamento" InputId="import-number" AutoFocus="true" />
        </form>
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Primary" OnClick="CloseAsync">Cancelar</MudButton>
        <MudButton Color="Color.Primary" ButtonType="ButtonType.Submit" form="import-form" Disabled="_saving">Importar</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private static readonly DialogOptions Options = new() { MaxWidth = MaxWidth.ExtraSmall, FullWidth = true, CloseOnEscapeKey = true };

    private bool _tasks = true;
    private bool _description = true;
    private string _number = string.Empty;
    private bool _saving;

    [Parameter, EditorRequired]
    public BudgetDetailsState State { get; set; } = null!;

    [Parameter]
    public bool Visible { get; set; }

    [Parameter]
    public EventCallback OnClosed { get; set; }

    private Task VisibleChanged(bool visible) => visible ? Task.CompletedTask : CloseAsync();

    private Task CloseAsync() => OnClosed.InvokeAsync();

    private async Task SubmitAsync()
    {
        _saving = true;
        try
        {
            if (await State.ImportAsync(new ImportBudgetRequest(_description, _tasks, _number)))
            {
                await CloseAsync();
            }
        }
        finally
        {
            _saving = false;
        }
    }
}
