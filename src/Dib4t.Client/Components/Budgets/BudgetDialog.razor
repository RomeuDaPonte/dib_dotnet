@inject IBudgetApi BudgetApi
@inject IUsersApi UsersApi
@inject AuthSession Session
@inject ISnackbar Snackbar

@* Legacy budgets/newBudgetModdal.jsx (new, edit) and cloneBudgetModalBody.jsx (clone): Cliente (Autocomplete over
   getallclients; not editable when editing), Descritivo, Responsável, Realizado por (the users of
   /api/account/users; that route needs canSeeDefinicoes, so other users get only themselves, as the legacy select
   effectively does), Cancel / Concluir (Clonar). Validated on submit, then on every change. *@
<MudDialog Visible="@(Form is not null)" VisibleChanged="VisibleChanged" Options="Options" Class="settings-dialog" AriaLabel="@Form?.Title">
    <TitleContent><h2 class="settings-dialog-title">@Form?.Title</h2></TitleContent>
    <DialogContent>
        @if (Form is not null)
        {
            <form id="budget-form" novalidate @onsubmit="SubmitAsync">
                <MudAutocomplete T="EntityResponse" Value="Form.Client" ValueChanged="ClientChanged" SearchFunc="SearchClients"
                                 ToStringFunc="@(c => c?.Name ?? string.Empty)" Label="Cliente" InputId="budget-client" AdornmentAriaLabel="Lista de clientes"
                                 Disabled="@(!Form.CanChangeClient)" MaxItems="null" Strict="false" ResetValueOnEmptyText="false"
                                 NoItemsTemplate="@NoClients" Margin="Margin.Normal"
                                 Error="@(_errors.Client is not null)" ErrorText="@_errors.Client" />
                <MudTextField T="string" @bind-Value="Form.Descriptive" @bind-Value:after="Revalidate" Immediate="true" Label="Descritivo"
                              InputId="budget-descriptive" Margin="Margin.Normal" Error="@(_errors.Descriptive is not null)" ErrorText="@_errors.Descriptive" />
                <MudTextField T="string" @bind-Value="Form.PersonInCharge" @bind-Value:after="Revalidate" Immediate="true" Label="Responsável"
                              InputId="budget-person" Margin="Margin.Normal" Error="@(_errors.PersonInCharge is not null)" ErrorText="@_errors.PersonInCharge" />
                <LabeledSelect TValue="string" Id="budget-made-by" Label="Realizado por" Value="Form.MadeById" ValueChanged="MadeByChanged"
                               Options="UserOptions" Placeholder="@string.IsNullOrEmpty(Form.MadeById)" Error="@_errors.MadeById" />
            </form>
        }
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Primary" OnClick="CloseAsync">Cancel</MudButton>
        <MudButton Color="Color.Primary" ButtonType="ButtonType.Submit" form="budget-form" Disabled="_saving">@Form?.SubmitText</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private static readonly DialogOptions Options = new() { MaxWidth = MaxWidth.ExtraSmall, FullWidth = true, CloseOnEscapeKey = true };

    private static readonly RenderFragment NoClients = builder => builder.AddContent(0, "Sem resultados");

    private IReadOnlyList<EntityResponse> _clients = [];
    private IReadOnlyList<(string Id, string Name)> _users = [];
    private BudgetForm? _shown;
    private BudgetFormErrors _errors = BudgetFormErrors.None;
    private bool _validateOnChange;
    private bool _saving;

    /// <summary>The form; <c>null</c> = the dialog is closed.</summary>
    [Parameter]
    public BudgetForm? Form { get; set; }

    /// <summary>The saved budget (new, clone: the new one; edit: as saved).</summary>
    [Parameter]
    public EventCallback<BudgetResponse> OnSaved { get; set; }

    [Parameter]
    public EventCallback OnClosed { get; set; }

    /// <summary>The users by name; the form's current author is offered too, so the select shows it.</summary>
    private IReadOnlyList<(string Value, string Text)> UserOptions
    {
        get
        {
            var users = _users.ToList();
            if (Form?.MadeById is { } id && users.All(u => u.Id != id))
            {
                users.Insert(0, (id, id == Session.User?.Id ? Session.User?.Name ?? id : id));
            }

            return [.. users.Select(u => (u.Id, u.Name))];
        }
    }

    protected override async Task OnInitializedAsync()
    {
        var clients = await BudgetApi.ListClientsAsync();
        if (clients.IsSuccess)
        {
            _clients = clients.Value!;
            Form?.ResolveClient(_clients);
        }

        var users = await UsersApi.ListAsync();
        if (users.IsSuccess)
        {
            _users = [.. users.Value!.Select(u => (u.Id, u.Name ?? string.Empty))];
        }
    }

    protected override void OnParametersSet()
    {
        if (!ReferenceEquals(Form, _shown))
        {
            _shown = Form; // a new dialog: no messages until its first submit
            _errors = BudgetFormErrors.None;
            _validateOnChange = false;
            Form?.ResolveClient(_clients);
        }
    }

    private Task<IEnumerable<EntityResponse>> SearchClients(string? text, CancellationToken cancellationToken) =>
        Task.FromResult(BudgetForm.FilterClients(_clients, text));

    private void ClientChanged(EntityResponse? client)
    {
        Form!.Client = client;
        Revalidate();
    }

    private void MadeByChanged(string? id)
    {
        Form!.MadeById = id;
        Revalidate();
    }

    private void Revalidate()
    {
        if (_validateOnChange)
        {
            _errors = Form!.Validate();
        }
    }

    private async Task SubmitAsync()
    {
        var form = Form!;
        _validateOnChange = true;
        _errors = form.Validate();
        if (_errors.Any || _saving)
        {
            return;
        }

        _saving = true;
        try
        {
            switch (form.Mode)
            {
                case BudgetDialogMode.Edit:
                    var edited = await BudgetApi.UpdateAsync(form.BudgetId!, form.ToUpdateRequest());
                    if (Show(edited.IsSuccess, edited.IsUnexpected, edited.ErrorText))
                    {
                        Snackbar.Add("Orçamento editado com sucesso!", Severity.Success);
                        await OnSaved.InvokeAsync(edited.Value!);
                    }

                    break;
                default:
                    var saved = form.Mode == BudgetDialogMode.Clone
                        ? await BudgetApi.CloneAsync(form.BudgetId!, form.ToNewRequest())
                        : await BudgetApi.CreateAsync(form.ToNewRequest());
                    if (!Show(saved.IsSuccess, saved.IsUnexpected, saved.ErrorText))
                    {
                        break;
                    }

                    if (saved.Value!.Notice is { } notice)
                    {
                        // A supplier: the legacy 200 text, nothing created (legacy crashes the dialog here).
                        Snackbar.Add(notice, Severity.Warning);
                        break;
                    }

                    if (form.Mode == BudgetDialogMode.New)
                    {
                        Snackbar.Add("Orçamento criado com sucesso!", Severity.Success);
                    }

                    await OnSaved.InvokeAsync(saved.Value.Budget!);
                    break;
            }
        }
        finally
        {
            _saving = false;
        }
    }

    /// <summary><c>true</c> on success; a 4xx text is shown as the legacy error toast.</summary>
    private bool Show(bool success, bool unexpected, string? text)
    {
        if (!success && !unexpected)
        {
            Snackbar.Add(text!, Severity.Error);
        }

        return success;
    }

    private Task VisibleChanged(bool visible) => visible ? Task.CompletedTask : CloseAsync();

    private Task CloseAsync() => OnClosed.InvokeAsync();
}
