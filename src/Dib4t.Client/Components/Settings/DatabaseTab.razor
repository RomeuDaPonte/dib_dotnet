@implements IAsyncDisposable
@inject IDatabaseApi Database
@inject IDatabaseTransfers Transfers
@inject ISnackbar Snackbar
@inject TimeProvider Time
@inject Dib4t.Client.Theme.ThemeState Theme

@* Legacy settings/databaseBackup.jsx (PLAN.md §7.6): "Transferir Backup", "Restaurar Backup" (a .dibbak, confirmed in
   "Restaurar backup"), the server's running operation, the database statistics and one row per collection. While a
   backup or restore runs, a full-page overlay shows its progress and leaving the page asks first. The file goes from
   the browser to the server and back without passing through the app's memory (wwwroot/js/database.js).
   New app (PLAN.md §7.6): once uploaded, the restore runs on the server; the overlay shows its stage (read from
   GET restore/status), a page opened or reloaded during a restore follows it, and the result dialog shows the built-in
   verification, the adjustments for MongoDB 9.0 and the automatic copy of the previous database. *@
<div class="database">
    <div class="database-header">
        <h2 class="database-title">Base de Dados</h2>
        <div class="database-actions">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.CloudDownload"
                       Disabled="Busy" OnClick="BackupAsync">Transferir Backup</MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.Restore"
                       Disabled="Busy" OnClick="ChooseFileAsync" Class="@(Theme.IsDarkMode ? "database-restore database-restore--dark" : "database-restore")">Restaurar Backup</MudButton>
            <input type="file" accept="@DatabaseFormat.BackupExtension" class="database-file" tabindex="-1" aria-hidden="true"
                   @ref="_fileInput" @onchange="FileChangedAsync" />
        </div>
    </div>

    @if (_info?.BusyWith is { } running)
    {
        <p class="database-busy" role="status">Existe uma operação em curso no servidor (@running).</p>
    }

    <div class="database-info-head">
        <h3 class="database-subtitle">Informação</h3>
        @if (_info is not null)
        {
            <span class="database-fetched">Atualizado @DatabaseFormat.Local(_info.FetchedAt, Time.LocalTimeZone, "dd/MM/yyyy HH:mm:ss")</span>
        }
        <MudTooltip Text="Atualizar">
            <MudIconButton Icon="@Icons.Material.Filled.Refresh" Size="Size.Small" aria-label="Atualizar" Disabled="_loadingInfo" OnClick="LoadInfoAsync" />
        </MudTooltip>
    </div>
    @if (_loadingInfo)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="database-loading" aria-label="A carregar" />
    }

    @if (_info is { } info)
    {
        <MudGrid Spacing="2" Class="database-stats">
            <MudItem xs="12" sm="6" md="3">@Stat("Base de dados", info.Name, $"{info.Host}:{info.Port}")</MudItem>
            <MudItem xs="12" sm="6" md="3">@Stat("Versão MongoDB", info.ServerVersion ?? string.Empty)</MudItem>
            <MudItem xs="12" sm="6" md="3">@Stat("Coleções", DatabaseFormat.Number(info.Collections))</MudItem>
            <MudItem xs="12" sm="6" md="3">@Stat("Documentos", DatabaseFormat.Number(info.Documents), $"Tamanho médio {DatabaseFormat.Bytes(info.AvgObjSize)}")</MudItem>
            <MudItem xs="12" sm="6" md="4">@Stat("Tamanho dos dados", DatabaseFormat.Bytes(info.DataSize))</MudItem>
            <MudItem xs="12" sm="6" md="4">@Stat("Armazenamento em disco", DatabaseFormat.Bytes(info.StorageSize))</MudItem>
            <MudItem xs="12" sm="12" md="4">@Stat("Índices", DatabaseFormat.Number(info.Indexes), DatabaseFormat.Bytes(info.IndexSize))</MudItem>
        </MudGrid>

        <div class="database-table-scroll" tabindex="0" role="region" aria-label="Tabela de coleções">
            <table class="database-table" aria-label="Coleções">
                <thead>
                    <tr>
                        <th scope="col">Coleção</th>
                        <th scope="col" class="database-numeric">Documentos</th>
                        <th scope="col" class="database-numeric">Tamanho</th>
                        <th scope="col" class="database-numeric">Tamanho médio</th>
                        <th scope="col" class="database-numeric">Armazenamento</th>
                        <th scope="col" class="database-numeric">Índices</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var collection in info.CollectionsInfo)
                    {
                        <tr @key="collection.Name">
                            <td class="database-name">@collection.Name</td>
                            <td class="database-numeric">@DatabaseFormat.Number(collection.Count)</td>
                            <td class="database-numeric">@DatabaseFormat.Bytes(collection.Size)</td>
                            <td class="database-numeric">@DatabaseFormat.Bytes(collection.AvgObjSize)</td>
                            <td class="database-numeric">@DatabaseFormat.Bytes(collection.StorageSize)</td>
                            <td class="database-numeric">@IndexesText(collection)</td>
                        </tr>
                    }
                    @if (info.CollectionsInfo.Count == 0)
                    {
                        <tr><td colspan="6" class="database-empty">A base de dados não tem coleções.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<MudDialog Visible="@(_fileToRestore is not null)" VisibleChanged="DialogVisibleChanged" Options="DialogOptions" Class="settings-dialog database-dialog"
           AriaLabel="Restaurar backup">
    <TitleContent><h2 class="settings-dialog-title">Restaurar backup</h2></TitleContent>
    <DialogContent>
        <div class="database-warning">
            <MudIcon Icon="@Icons.Material.Filled.WarningAmber" />
            <p>
                Todos os dados atuais da base de dados serão <b>apagados</b> e substituídos pelo conteúdo do backup. Esta ação
                não pode ser desfeita. Recomenda-se transferir um backup antes de continuar.
            </p>
        </div>
        <p class="database-safety">@RestoreTexts.SafetyNote</p>
        @if (_fileToRestore is { } file)
        {
            <div class="database-file-box">
                <p><b>Ficheiro:</b> @file.Name</p>
                <p><b>Tamanho:</b> @DatabaseFormat.Bytes(file.Size)</p>
                <p><b>Modificado:</b> @DatabaseFormat.Local(DateTimeOffset.FromUnixTimeMilliseconds((long)file.LastModified), Time.LocalTimeZone, "dd/MM/yyyy HH:mm")</p>
            </div>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="CancelRestoreAsync">Cancelar</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Secondary" OnClick="ConfirmRestoreAsync" Class="database-confirm">Restaurar</MudButton>
    </DialogActions>
</MudDialog>

<MudDialog Visible="@(_result is not null)" VisibleChanged="ResultVisibleChanged" Options="DialogOptions" Class="settings-dialog database-result"
           AriaLabel="Resultado do restauro">
    <TitleContent><h2 class="settings-dialog-title">@(_result is { } titled ? RestoreTexts.Title(titled) : string.Empty)</h2></TitleContent>
    <DialogContent>
        @if (_result is { } result)
        {
            @if (result.Stage == RestoreStatusResponse.Completed)
            {
                <p class="database-result-summary">@RestoreTexts.Summary(result)</p>
                @if (result.Verification is { } verification)
                {
                    <div class="@(verification.HasDifferences ? "database-verification database-verification--differences" : "database-verification")" role="status">
                        <MudIcon Icon="@(verification.HasDifferences ? Icons.Material.Filled.WarningAmber : Icons.Material.Filled.CheckCircle)" />
                        <div>
                            <p>@(verification.HasDifferences ? RestoreTexts.Differences : RestoreTexts.NoDifferences)</p>
                            @if (verification.HasDifferences)
                            {
                                <ul class="database-result-list">
                                    @foreach (var line in RestoreTexts.DifferenceLines(verification))
                                    {
                                        <li>@line</li>
                                    }
                                </ul>
                            }
                        </div>
                    </div>
                }
            }
            else
            {
                <p class="database-result-error">@(result.Error ?? "Erro ao restaurar o backup")</p>
                @if (!result.DatabaseChanged)
                {
                    <p>@RestoreTexts.Unchanged</p>
                }
            }

            @if (result.Adjustments.Count > 0)
            {
                <p class="database-result-heading">@RestoreTexts.AdjustmentsTitle</p>
                <ul class="database-result-list database-adjustments">
                    @foreach (var adjustment in result.Adjustments)
                    {
                        <li>@RestoreTexts.Adjustment(adjustment)</li>
                    }
                </ul>
            }

            @if (RestoreTexts.PreRestoreBackupLine(result) is { } safety)
            {
                <p class="database-result-backup">@safety</p>
            }
        }
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="CloseResult">Fechar</MudButton>
    </DialogActions>
</MudDialog>

@if (_operation is { } operation)
{
    <div class="database-overlay" tabindex="0" role="alertdialog" aria-modal="true" aria-labelledby="database-overlay-title" aria-describedby="database-overlay-message" aria-busy="true">
        <div class="database-progress">
            @if (operation.Percent is { } percent)
            {
                <MudProgressCircular Color="Color.Inherit" Value="percent" Min="0" Max="100" Class="database-progress-circle" aria-label="@($"{percent}%")" />
                <span class="database-percent">@($"{percent}%")</span>
            }
            else
            {
                <MudProgressCircular Color="Color.Inherit" Indeterminate="true" Class="database-progress-circle" aria-label="@operation.Title" />
            }
        </div>
        <h2 id="database-overlay-title" class="database-overlay-title">@operation.Title</h2>
        @if (operation.Message is not null)
        {
            <p id="database-overlay-message" class="database-overlay-message">@operation.Message</p>
        }
        <p class="database-overlay-caption">Não feche nem atualize esta página.</p>
    </div>
}

@code {
    public const string BackupTitle = "A criar backup da base de dados...";
    public const string RestoreTitle = "A restaurar a base de dados...";
    public const string ReplacingMessage = DatabaseTabMessages.Replacing;

    /// <summary>How often the page asks the server where its restore is.</summary>
    public static readonly TimeSpan StatusInterval = TimeSpan.FromSeconds(1);

    /// <summary>Failed status reads in a row after which the page stops following a restore (the server is gone).</summary>
    public const int StatusAttempts = 30;

    private static readonly DialogOptions DialogOptions = new() { MaxWidth = MaxWidth.Small, FullWidth = true, CloseOnEscapeKey = true };

    private ElementReference _fileInput;
    private DatabaseInfoResponse? _info;
    private bool _loadingInfo;
    private Operation? _operation;
    private ChosenFile? _fileToRestore;
    private RestoreStatusResponse? _result;
    private readonly CancellationTokenSource _disposed = new();

    /// <summary>What the overlay shows: legacy <c>{ title, message, percent }</c> (no percent: an indeterminate circle).</summary>
    public sealed record Operation(string Title, string? Message, int? Percent = null);

    private bool Busy => _operation is not null || _info?.BusyWith is not null;

    protected override async Task OnInitializedAsync()
    {
        await LoadInfoAsync();
        // A restore that is still running (this page was reloaded, or opened elsewhere): follow it to the end.
        if (_operation is null && await StatusAsync() is { Running: true } running)
        {
            _ = FollowRunningAsync(running);
        }
    }

    private async Task FollowRunningAsync(RestoreStatusResponse running)
    {
        await StartAsync(StageOperation(running));
        try
        {
            if (await FollowAsync(running.Id) is { } finished)
            {
                await ShowFinishedAsync(finished);
            }
        }
        finally
        {
            await StopAsync();
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task LoadInfoAsync()
    {
        _loadingInfo = true;
        try
        {
            var result = await Database.InfoAsync();
            if (result.IsSuccess)
            {
                _info = result.Value;
            }
            else
            {
                Snackbar.Add(OrFallback(result.ErrorText, "Erro ao obter informação da base de dados"), Severity.Error);
            }
        }
        finally
        {
            _loadingInfo = false;
        }
    }

    private async Task BackupAsync()
    {
        await StartAsync(new Operation(BackupTitle, "A preparar o ficheiro"));
        try
        {
            var result = await Transfers.DownloadBackupAsync(DatabaseFormat.BackupFileName(Time.GetLocalNow()), loaded =>
                ShowAsync(new Operation(BackupTitle, $"{DatabaseFormat.Bytes(loaded)} transferidos")));
            if (result.IsSuccess)
            {
                Snackbar.Add($"Backup criado com sucesso ({DatabaseFormat.Bytes(result.Size)})", Severity.Success);
            }
            else
            {
                Snackbar.Add(OrFallback(result.Text, "Erro ao criar o backup"), Severity.Error);
            }
        }
        finally
        {
            await StopAsync();
        }
    }

    private Task ChooseFileAsync() => Transfers.ChooseAsync(_fileInput);

    private async Task FileChangedAsync()
    {
        var file = await Transfers.TakeFileAsync(_fileInput);
        if (file is null)
        {
            return;
        }

        if (!DatabaseFormat.IsBackupFile(file.Name))
        {
            await Transfers.ForgetFileAsync();
            Snackbar.Add($"Selecione um ficheiro de backup ({DatabaseFormat.BackupExtension}).", Severity.Error);
            return;
        }

        _fileToRestore = file;
    }

    private async Task DialogVisibleChanged(bool visible)
    {
        if (!visible)
        {
            await CancelRestoreAsync();
        }
    }

    private async Task CancelRestoreAsync()
    {
        _fileToRestore = null;
        await Transfers.ForgetFileAsync();
    }

    private async Task ConfirmRestoreAsync()
    {
        if (_fileToRestore is null)
        {
            return;
        }

        _fileToRestore = null;
        var id = Guid.NewGuid().ToString("N");
        await StartAsync(new Operation(RestoreTitle, "A enviar o ficheiro", 0));
        using var uploaded = CancellationTokenSource.CreateLinkedTokenSource(_disposed.Token);
        Task? watching = null;
        try
        {
            var result = await Transfers.RestoreAsync(id, (loaded, total) =>
            {
                var progress = UploadProgress(loaded, total);
                if (progress.Percent is null)
                {
                    // The upload is complete: the server works on it now, ask it where it is.
                    watching ??= WatchAsync(id, uploaded.Token);
                }

                return ShowAsync(progress);
            });
            await uploaded.CancelAsync();
            if (watching is not null)
            {
                await watching;
            }

            if (result.IsSuccess && Restored(result.Text) is { } restored)
            {
                Snackbar.Add($"Base de dados restaurada: {DatabaseFormat.Number(restored.Collections)} coleções, {DatabaseFormat.Number(restored.Documents)} documentos.", Severity.Success);
                _result = await StatusAsync() is { Id: var statusId } status && statusId == id ? status : null;
                await LoadInfoAsync();
            }
            else if (result.Status == 0 && await FollowAsync(id) is { } finished)
            {
                // The answer was lost (connection, proxy), but the server had the file and restored it.
                await ShowFinishedAsync(finished);
            }
            else
            {
                Snackbar.Add(OrFallback(result.IsSuccess ? null : result.Text, "Erro ao restaurar o backup"), Severity.Error);
                if (result.Status >= 500 && await StatusAsync() is { DatabaseChanged: true } failed && failed.Id == id)
                {
                    _result = failed; // the database is incomplete: say where the previous one is
                }
            }
        }
        finally
        {
            await StopAsync();
        }
    }

    /// <summary>While the upload's answer is pending: the server's stage in the overlay, every <see cref="StatusInterval"/>.</summary>
    private async Task WatchAsync(string id, CancellationToken cancellationToken)
    {
        try
        {
            while (!cancellationToken.IsCancellationRequested)
            {
                await Task.Delay(StatusInterval, Time, cancellationToken);
                if (await StatusAsync() is { Running: true } status && status.Id == id && !cancellationToken.IsCancellationRequested)
                {
                    await ShowAsync(StageOperation(status));
                }
            }
        }
        catch (OperationCanceledException)
        {
            // the answer came (or the page is gone)
        }
    }

    /// <summary>
    /// Follows the restore <paramref name="id"/> on the server until it ends: its status when it ended, or
    /// <see langword="null"/> when the server has another restore or none, or does not answer any more.
    /// </summary>
    private async Task<RestoreStatusResponse?> FollowAsync(string id)
    {
        var failures = 0;
        while (!_disposed.IsCancellationRequested)
        {
            var answer = await Database.RestoreStatusAsync();
            if (answer.IsSuccess)
            {
                failures = 0;
                if (answer.Value is not { } status || status.Id != id)
                {
                    return null;
                }

                if (!status.Running)
                {
                    return status;
                }

                await ShowAsync(StageOperation(status));
            }
            else if (++failures >= StatusAttempts)
            {
                return null;
            }

            try
            {
                await Task.Delay(StatusInterval, Time, _disposed.Token);
            }
            catch (OperationCanceledException)
            {
                return null;
            }
        }

        return null;
    }

    /// <summary>A followed restore ended: the legacy notification, then the result dialog.</summary>
    private async Task ShowFinishedAsync(RestoreStatusResponse finished)
    {
        if (finished.Stage == RestoreStatusResponse.Completed)
        {
            Snackbar.Add($"Base de dados restaurada: {DatabaseFormat.Number(finished.Collections ?? 0)} coleções, {DatabaseFormat.Number(finished.Documents ?? 0)} documentos.", Severity.Success);
            _result = finished;
        }
        else
        {
            Snackbar.Add(OrFallback(finished.Error, "Erro ao restaurar o backup"), Severity.Error);
            _result = finished.Stage == RestoreStatusResponse.Failed ? finished : null;
        }

        await LoadInfoAsync();
    }

    private async Task<RestoreStatusResponse?> StatusAsync()
    {
        var answer = await Database.RestoreStatusAsync();
        return answer.IsSuccess ? answer.Value : null;
    }

    /// <summary>The overlay for a restore the server is working on.</summary>
    public static Operation StageOperation(RestoreStatusResponse status)
    {
        var (message, percent) = RestoreTexts.Stage(status);
        return new Operation(RestoreTitle, message, percent);
    }

    private Task ResultVisibleChanged(bool visible)
    {
        if (!visible)
        {
            _result = null;
        }

        return Task.CompletedTask;
    }

    private void CloseResult() => _result = null;

    /// <summary>Legacy <c>onUploadProgress</c>: the percent sent; at 100 % the server replaces the data (no percent).</summary>
    public static Operation UploadProgress(double loaded, double total)
    {
        var percent = total > 0 ? (int)Math.Floor((loaded / total * 100) + 0.5) : 0; // Math.round
        return percent >= 100
            ? new Operation(RestoreTitle, ReplacingMessage)
            : new Operation(RestoreTitle, $"A enviar o ficheiro ({DatabaseFormat.Bytes(loaded)} de {DatabaseFormat.Bytes(total)})", percent);
    }

    private static RestoreResponse? Restored(string json)
    {
        try
        {
            return System.Text.Json.JsonSerializer.Deserialize<RestoreResponse>(json, System.Text.Json.JsonSerializerOptions.Web);
        }
        catch (System.Text.Json.JsonException)
        {
            return null;
        }
    }

    private static string IndexesText(CollectionInfoResponse collection) =>
        collection.IndexSize is null
            ? DatabaseFormat.Number(collection.Indexes)
            : $"{DatabaseFormat.Number(collection.Indexes)} ({DatabaseFormat.Bytes(collection.IndexSize)})";

    /// <summary>Legacy <c>readErrorMessage</c>: the answer's text, or the fallback when there is none.</summary>
    private static string OrFallback(string? text, string fallback) => string.IsNullOrEmpty(text) ? fallback : text;

    private async Task StartAsync(Operation operation)
    {
        _operation = operation;
        await Transfers.GuardUnloadAsync(true);
    }

    private Task ShowAsync(Operation operation) => InvokeAsync(() =>
    {
        _operation = operation;
        StateHasChanged();
    });

    private async Task StopAsync()
    {
        _operation = null;
        await Transfers.GuardUnloadAsync(false);
    }

    private static RenderFragment Stat(string label, string value, string? detail = null) => @<div class="database-stat">
        <div class="database-stat-label">@label</div>
        <div class="database-stat-value">@value</div>
        @if (detail is not null)
        {
            <div class="database-stat-detail">@detail</div>
        }
    </div>;

    public async ValueTask DisposeAsync()
    {
        await _disposed.CancelAsync();
        _disposed.Dispose();
        if (_operation is not null)
        {
            await Transfers.GuardUnloadAsync(false);
        }
    }
}
