{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    }
  },
  "Logs": {
    "Path": "/app/logs/dib4t-logs.db",
    "ConsoleMinimumLevel": "Warning"
  },
  "Backup": {
    "Directory": "/app/backups"
  },
  "AllowedHosts": "*"
}
