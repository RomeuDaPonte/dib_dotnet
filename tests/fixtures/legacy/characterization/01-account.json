    {
      "id": "user-me-legacy",
      "title": "GET /account/me does not exist in legacy (cast error on /:id)",
      "request": {
        "method": "GET",
        "path": "/api/account/me",
        "auth": "admin",
        "body": null
      },
      "response": {
        "status": 500,
        "contentType": "text/html; charset=utf-8",
        "expressErrorPage": {
          "error": "CastError: Cast to ObjectId failed for value \"me\" (type string) at path \"_id\" for model \"User\""
        }
      },
      "db": {}
    },
    {
      "id": "user-update",
      "title": "Update user without password",
      "request": {
        "method": "PUT",
        "path": "/api/account/{{users:3}}",
        "auth": "admin",
        "body": {
          "name": "Bruno Maquinação Silva",
          "email": "bruno.limitado@dib4t.local",
          "roles": [
            "canSeeObras",
            "canSeeLeituras",
            "canSeeHistorico"
          ],
          "fieldOfCompetencies": "Montagem"
        }
      },
      "response": {
        "status": 200,
        "contentType": "application/json; charset=utf-8",
        "json": {
          "_id": "{{users:3}}",
          "name": "Bruno Maquinação Silva",
          "email": "bruno.limitado@dib4t.local",
          "roles": [
            "canSeeObras",
            "canSeeLeituras",
            "canSeeHistorico"
          ]
        }
      },
      "db": {
        "users": {
          "updated": [
            {
              "_id": {
                "$oid": "{{users:3}}"
              },
              "changed": [
                "roles",
                "fieldOfCompetencies",
                "name",
                "__v"
              ],
              "after": {
                "_id": {
                  "$oid": "{{users:3}}"
                },
                "roles": [
                  "canSeeObras",
                  "canSeeLeituras",
                  "canSeeHistorico"
                ],
                "fieldOfCompetencies": "Montagem",
                "name": "Bruno Maquinação Silva",
                "email": "bruno.limitado@dib4t.local",
                "password": "{{bcrypt:$2a$10$}}",
                "__v": {
                  "$numberInt": "1"
                }
              }
            }
          ]
        }
      }
    },
