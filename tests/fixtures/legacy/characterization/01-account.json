    {
      "id": "create-admin-user",
      "title": "Create a user with every role",
      "request": {
        "method": "POST",
        "path": "/api/account/create",
        "auth": "tool",
        "body": {
          "name": "Ana Administradora",
          "email": "ana.admin@dib4t.local",
          "password": "char-test-1",
          "passwordConfirmation": "char-test-1",
          "roles": [
            "canSeeOrcamentos",
            "canSeeObras",
            "canSeeHistorico",
            "canSeeEntidades",
            "canSeeDefinicoes",
            "canSeeDashboard",
            "canSeeLeituras"
          ],
          "fieldOfCompetencies": "Desenvolvimento"
        }
      },
      "response": {
        "status": 200,
        "contentType": "application/json; charset=utf-8",
        "json": {
          "_id": "{{users:2}}",
          "name": "Ana Administradora",
          "email": "ana.admin@dib4t.local",
          "roles": [
            "canSeeOrcamentos",
            "canSeeObras",
            "canSeeHistorico",
            "canSeeEntidades",
            "canSeeDefinicoes",
            "canSeeDashboard",
            "canSeeLeituras"
          ]
        }
      },
      "db": {
        "users": {
          "inserted": [
            {
              "_id": {
                "$oid": "{{users:2}}"
              },
              "roles": [
                "canSeeOrcamentos",
                "canSeeObras",
                "canSeeHistorico",
                "canSeeEntidades",
                "canSeeDefinicoes",
                "canSeeDashboard",
                "canSeeLeituras"
              ],
              "fieldOfCompetencies": "Desenvolvimento",
              "name": "Ana Administradora",
              "email": "ana.admin@dib4t.local",
              "password": "{{bcrypt:$2a$10$}}",
              "__v": {
                "$numberInt": "0"
              }
            }
          ]
        }
      }
    },
