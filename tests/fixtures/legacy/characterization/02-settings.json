    {
      "id": "prices-update",
      "title": "Update prices",
      "request": {
        "method": "POST",
        "path": "/api/prices",
        "auth": "admin",
        "body": {
          "automation": 32.5,
          "consultancy": 45,
          "development": 30,
          "machining": 38,
          "assembly": 28,
          "margin": 35
        }
      },
      "response": {
        "status": 200,
        "contentType": "application/json; charset=utf-8",
        "json": {
          "automation": 32.5,
          "consultancy": 45,
          "development": 30,
          "machining": 38,
          "assembly": 28,
          "margin": 35
        }
      },
      "db": {
        "prices": {
          "updated": [
            {
              "_id": {
                "$oid": "{{prices:1}}"
              },
              "changed": [
                "automation",
                "consultancy",
                "development",
                "machining",
                "assembly"
              ],
              "after": {
                "_id": {
                  "$oid": "{{prices:1}}"
                },
                "automation": {
                  "$numberDouble": "32.5"
                },
                "consultancy": {
                  "$numberInt": "45"
                },
                "development": {
                  "$numberInt": "30"
                },
                "margin": {
                  "$numberInt": "35"
                },
                "machining": {
                  "$numberInt": "38"
                },
                "assembly": {
                  "$numberInt": "28"
                },
                "__v": {
                  "$numberInt": "0"
                }
              }
            }
          ]
        }
      }
    },
