    {
      "id": "db-backup",
      "title": "Backup download (body summarized)",
      "request": {
        "method": "GET",
        "path": "/api/database/backup",
        "auth": "admin",
        "body": null
      },
      "response": {
        "status": 200,
        "contentType": "application/gzip",
        "contentDisposition": "attachment; filename=\"dib4t-backup-{{stamp}}.dibbak\"",
        "accessControlExposeHeaders": "Content-Disposition",
        "body": {
          "gzip": true,
          "magic": "DIBBAK01",
          "header": {
            "format": "dib4t-backup",
            "version": 1,
            "createdAt": "{{now}}",
            "createdBy": "ana.admin@dib4t.local",
            "database": "dib4t",
            "serverVersion": "4.1.4",
            "collections": [
              "budgets",
              "entities",
              "jobs",
              "paymentmethods",
              "prices",
              "printersettings",
              "tasks",
              "users"
            ]
          },
          "collections": [
            {
              "meta": {
                "name": "budgets",
                "options": {},
                "indexes": [
                  {
                    "v": 2,
                    "key": {
                      "_id": 1
                    },
                    "name": "_id_",
                    "ns": "dib4t.budgets"
                  }
                ],
                "count": 7
              },
              "documents": 7
            },
            {
