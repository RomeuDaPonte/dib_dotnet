    {
      "id": "db-restore-empty",
      "title": "Restore without a body",
      "request": {
        "method": "POST",
        "path": "/api/database/restore",
        "auth": "admin",
        "body": {
          "contentType": "application/octet-stream",
          "content": "(empty)"
        }
      },
      "response": {
        "status": 400,
        "contentType": "text/html; charset=utf-8",
        "text": "Nenhum ficheiro de backup recebido."
      },
      "db": {}
    },
    {
      "id": "db-restore-garbage",
      "title": "Restore a non-backup file",
      "request": {
        "method": "POST",
        "path": "/api/database/restore",
        "auth": "admin",
        "body": {
          "contentType": "application/octet-stream",
          "content": "the ASCII text 'this is not a backup'"
        }
      },
      "response": {
        "status": 400,
        "contentType": "text/html; charset=utf-8",
        "text": "O ficheiro não é um backup válido da Dib4t."
      },
      "db": {}
    },
    {
      "id": "db-restore-truncated",
      "title": "Restore a truncated backup",
      "request": {
        "method": "POST",
        "path": "/api/database/restore",
        "auth": "admin",
        "body": {
          "contentType": "application/octet-stream",
          "content": "first half of the db-backup body"
        }
      },
      "response": {
        "status": 400,
        "contentType": "text/html; charset=utf-8",
        "text": "O ficheiro não é um backup válido da Dib4t."
      },
      "db": {}
    },
    {
      "id": "db-restore",
      "title": "Restore the backup just taken (DB unchanged)",
      "request": {
        "method": "POST",
        "path": "/api/database/restore",
        "auth": "admin",
        "body": {
          "contentType": "application/octet-stream",
          "content": "the db-backup body"
        }
      },
      "response": {
        "status": 200,
        "contentType": "application/json; charset=utf-8",
        "json": {
          "backupCreatedAt": "{{now}}",
          "backupDatabase": "dib4t",
          "collections": 8,
          "documents": 50
        }
      },
      "db": {}
    }
