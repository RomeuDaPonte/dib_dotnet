    {
      "id": "entity-update",
      "title": "Update entity (picked fields)",
      "request": {
        "method": "PUT",
        "path": "/api/entity/{{entities:2}}",
        "auth": "admin",
        "body": {
          "name": "Cortiças Reunidas",
          "fiscalNumber": "500999888",
          "address": "Lugar da Cortiça",
          "zipCode": "4535-000",
          "location": "Santa Maria da Feira",
          "paymentCondition": "Transferência a 30 dias",
          "type": "Cliente e Fornecedor"
        }
      },
      "response": {
        "status": 200,
        "contentType": "application/json; charset=utf-8",
        "json": {
          "_id": "{{entities:2}}",
          "name": "Cortiças Reunidas",
          "fiscalNumber": "500999888",
          "address": "Lugar da Cortiça",
          "zipCode": "4535-000",
          "location": "Santa Maria da Feira",
          "paymentCondition": "Transferência a 30 dias",
          "type": "Cliente e Fornecedor"
        }
      },
      "db": {
        "entities": {
          "updated": [
            {
              "_id": {
                "$oid": "{{entities:2}}"
              },
              "changed": [
                "address",
                "fiscalNumber",
                "location",
                "zipCode"
              ],
              "after": {
                "_id": {
                  "$oid": "{{entities:2}}"
                },
                "name": "Cortiças Reunidas",
                "paymentCondition": "Transferência a 30 dias",
                "type": "Cliente e Fornecedor",
                "__v": {
                  "$numberInt": "0"
                },
                "address": "Lugar da Cortiça",
                "fiscalNumber": "500999888",
                "location": "Santa Maria da Feira",
                "zipCode": "4535-000"
              }
            }
          ]
        }
      }
    },
