{
  "area": "07-account-delete",
  "steps": [
    {
      "id": "user-delete-d2",
      "title": "DELETE /account/:id deletes the FIRST user, not :id (D2)",
      "request": {
        "method": "DELETE",
        "path": "/api/account/{{users:3}}",
        "auth": "admin",
        "body": null
      },
      "response": {
        "status": 200,
        "contentType": "application/json; charset=utf-8",
        "json": {
          "_id": "{{users:3}}",
          "name": "Bruno Maquinação Silva",
          "email": "bruno.limitado@dib4t.local",
          "roles": [
            "canSeeObras",
            "canSeeLeituras",
            "canSeeHistorico"
          ]
        }
      },
      "db": {
        "users": {
          "deleted": [
            {
              "_id": {
                "$oid": "{{users:1}}"
              },
              "roles": [
                "canSeeDefinicoes",
                "canSeeEntidades",
                "canSeeOrcamentos",
                "canSeeObras",
                "canSeeHistorico",
                "canSeeDashboard"
              ],
              "fieldOfCompetencies": "Desenvolvimento",
              "name": "User Logado",
              "email": "userlogado@gmail.com",
              "password": "{{bcrypt:$2b$10$}}",
              "__v": {
                "$numberInt": "0"
              }
            }
          ]
        }
      }
    },
    {
      "id": "user-delete-missing",
      "title": "Delete unknown user → 404",
      "request": {
        "method": "DELETE",
        "path": "/api/account/{{oid:1}}",
        "auth": "admin",
        "body": null
      },
      "response": {
        "status": 404,
        "contentType": "text/html; charset=utf-8",
        "text": "Utilizador não exista na bd"
      },
      "db": {}
    },
